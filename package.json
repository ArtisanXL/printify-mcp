{
  "name": "@artisanxl/printify-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Printify API",
  "type": "module",
  "bin": {
    "printify-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "printify",
    "print-on-demand"
  ],
  "author": "ArtisanXL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtisanXL/printify-mcp.git"
  },
  "homepage": "https://github.com/ArtisanXL/printify-mcp#readme",
  "bugs": {
    "url": "https://github.com/ArtisanXL/printify-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
