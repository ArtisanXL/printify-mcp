{
  "name": "@artisanxl/printify-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Printify API",
  "type": "module",
  "bin": {
    "printify-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "refresh-spec": "tsx scripts/refresh-spec.ts",
    "generate": "tsx scripts/generate/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "printify",
    "print-on-demand"
  ],
  "author": "ArtisanXL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtisanXL/printify-mcp.git"
  },
  "homepage": "https://github.com/ArtisanXL/printify-mcp#readme",
  "bugs": {
    "url": "https://github.com/ArtisanXL/printify-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
