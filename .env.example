# Printify personal access token (required).
PRINTIFY_API_TOKEN=

# Read-only Mode (default: on). Write Tools are only offered when this is
# "false" or "0" (case-insensitive). Any other value, or unset, keeps it on.
# PRINTIFY_READ_ONLY=true

# Comma-separated Toolsets to offer (default: all).
# Valid: catalog, orders, personalization, products, shops, support_requests, uploads, webhooks
# PRINTIFY_TOOLSETS=catalog,products,uploads

# Printify API base URL, without a version prefix (default: https://api.printify.com).
# PRINTIFY_API_BASE=https://api.printify.com
